{
  "name": "tutorials.NGSI-LD",
  "description": "An Express App for providing context data to FIWARE NGSI-LD Components",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FIWARE/tutorials.NGSI-LD.git"
  },
  "bugs": {
    "url": "https://github.com/FIWARE/tutorials.NGSI-LD/issues"
  },
  "homepage": "https://ngsi-ld-tutorials.rtfd.io/",
  "author": "FIWARE Foundation e.V.",
  "keywords": [
    "node",
    "fiware",
    "tutorial",
    "ngsi"
  ],
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "main": "dist/bin/www.js",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "body-parser": "^1.19.2",
    "connect-flash": "^0.1.1",
    "connect-mongo": "^4.6.0",
    "cookie-parser": "~1.4.6",
    "debug": "~4.3.3",
    "did-jwt": "^6.11.0",
    "did-jwt-vc": "^3.1.0",
    "did-resolver": "^4.0.1",
    "elliptic": "^6.5.4",
    "express": "~4.17.3",
    "express-healthcheck": "^0.1.0",
    "express-session": "^1.17.2",
    "fast-csv": "^4.3.2",
    "http-errors": "^2.0.0",
    "http-status-codes": "^2.1.4",
    "jsonld": "^8.3.3",
    "jsonwebtoken": "^9.0.0",
    "jwks-rsa": "^3.0.0",
    "lodash": "^4.17.21",
    "moment": "~2.29.1",
    "moment-timezone": "~0.5.25",
    "mongoose": "^6.2.2",
    "morgan": "^1.10.0",
    "mqtt": "^4.3.6",
    "multer": "^2.0.2",
    "parse-links": "^0.1.0",
    "pug": "3.0.2",
    "request": "^2.88.2",
    "request-promise": "^4.2.6",
    "socket.io": "^4.7.5",
    "twitter": "^1.7.1",
    "web-did-resolver": "^2.0.30",
    "xml-parser": "^1.2.1",
    "xml2js": "^0.4.23"
  },
  "devDependencies": {
    "@types/connect-flash": "^0.0.40",
    "@types/cookie-parser": "^1.4.0",
    "@types/debug": "^4.1.0",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.17.0",
    "@types/lodash": "^4.17.0",
    "@types/moment": "^2.13.0",
    "@types/morgan": "^1.9.0",
    "@types/multer": "^1.4.0",
    "@types/node": "^22.0.0",
    "ajv": "^8.10.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "lint-staged": "^12.3.4",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "scripts": {
    "build": "tsc && cp -r views dist/ && cp -r public dist/ && mkdir -p dist/resources",
    "start": "node ./dist/bin/www.js",
    "healthcheck": "node ./dist/bin/healthcheck.js",
    "no_devices": "DEBUG=tutorial.* DUMMY_OFF=false npm start",
    "test": "npm run lint",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "prettier": "prettier --single-quote --write \"**/*.ts\""
  },
  "lint-staged": {
    "*.ts": [
      "prettier --single-quote --write",
      "eslint --fix"
    ],
    "*.md": [
      "prettier --parser markdown --tab-width 4 --print-width 120 --write --prose-wrap always"
    ],
    "*.yml": [
      "prettier --no-config --tab-width 4 --print-width 120 --write"
    ]
  }
}
