# Local test image — builds from this working copy instead of downloading source
# from GitHub (as the production Dockerfile does). Single stage, node:20-slim.
#
#   docker build -f Dockerfile.local -t quay.io/fiware/tutorials.ngsi-ld .
#   docker compose up -d --force-recreate tutorial
#
# Restore the published image afterwards with: docker compose pull tutorial

FROM node:20-slim
WORKDIR /opt/ngsi-tutorial

COPY package.json package-lock.json ./
RUN npm install --no-optional

COPY . .
RUN npm run build && npm prune --omit=dev

ENV NODE_ENV=production
EXPOSE 3000

CMD ["node", "/opt/ngsi-tutorial/dist/bin/www.js"]
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s \
  CMD ["node", "/opt/ngsi-tutorial/dist/bin/healthcheck.js"]
