    "morgan": "^1.10.0",
    "mqtt": "^4.3.6",
    "redis": "^5.8.0",
    "xml-parser": "^1.2.1",
    "xml2js": "^0.4.23"
  },
  "devDependencies": {
    "@types/debug": "^4.1.0",
    "@types/express": "^5.0.0",
    "@types/http-errors": "^2.0.0",
    "@types/lodash": "^4.17.0",
    "@types/morgan": "^1.9.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
