  "description": "Dummy IoT devices",
  "version": "1.0.0",
  "main": "dist/bin/devices.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node ./dist/bin/devices.js",
    "healthcheck": "node ./dist/bin/healthcheck.js",
    "local": "HISTORY_LOG=append.csv PIG_COUNT=0 COW_COUNT=40 DEBUG=devices.* npm start",
